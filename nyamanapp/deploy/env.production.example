# ---------------------------------------------------------------
# Contoh .env untuk PRODUKSI (cPanel / shared hosting)
# Salin menjadi .env di server, lalu isi APP_KEY & APP_URL.
# JANGAN memakai APP_KEY dari paket contoh — buat yang baru:
#     php artisan key:generate
# ---------------------------------------------------------------
APP_NAME="NyamanSuperApp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---------------------------------------------------------------
# DATABASE
# SQLite: cukup untuk 1 penginapan. Pakai path ABSOLUT di cPanel.
# Ganti /home/USERCPANEL/ sesuai username hosting Anda.
# ---------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/home/USERCPANEL/nyaman-app/database/database.sqlite

# Kalau memilih MySQL bawaan cPanel, komentari dua baris di atas
# lalu aktifkan yang di bawah ini:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=usercpanel_nyaman
# DB_USERNAME=usercpanel_nyaman
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# ------------------------------------------------------------------
# AKUN AWAL (dipakai oleh `php artisan db:seed`)
# Kosongkan PASSWORD -> sandi acak dibuat dan DICETAK SEKALI di terminal.
# Setelah akun terbentuk, sebaiknya kosongkan/hapus lagi baris-baris ini
# supaya kata sandi tidak tersimpan di berkas.
# ------------------------------------------------------------------
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

STAFF_NAME="Staff Resepsionis"
STAFF_EMAIL=
STAFF_PASSWORD=
