APP_NAME="NyamanSuperApp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------------------
# DATABASE - default: SQLite (tanpa setup, file database/database.sqlite)
# ------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE otomatis ke database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# ------------------------------------------------------------------
# AKUN AWAL (dipakai oleh `php artisan db:seed`)
# Kosongkan PASSWORD -> sandi acak dibuat dan DICETAK SEKALI di terminal.
# Setelah akun terbentuk, sebaiknya kosongkan/hapus lagi baris-baris ini
# supaya kata sandi tidak tersimpan di berkas.
# ------------------------------------------------------------------
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

STAFF_NAME="Staff Resepsionis"
STAFF_EMAIL=
STAFF_PASSWORD=
